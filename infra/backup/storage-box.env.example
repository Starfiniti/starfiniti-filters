# Copy to /etc/starfiniti-backup/pve-borg.env on the Proxmox host.
# This file is shell-sourced and must be owned by root with mode 0600.

BORG_REPO="ssh://uXXXXX-sub1@uXXXXX-sub1.your-storagebox.de:23/./starfiniti-s2"
BORG_REMOTE_PATH="borg-1.4"
BORG_RSH="ssh -i /root/.ssh/starfiniti-storage-box-backup -p 23 -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes -o UserKnownHostsFile=/etc/starfiniti-backup/storage-box-known-hosts"
BORG_PASSCOMMAND="cat /etc/starfiniti-backup/borg-passphrase"
BORG_COMPRESSION="zstd,3"

# Empty means all QEMU and LXC guests, excluding QEMU templates.
PVE_GUEST_IDS=""
PVE_INCLUDE_TEMPLATES="0"

# Fail before snapshot creation when the thin pool crosses either boundary.
PVE_THIN_POOL_LV="vg0/data"
PVE_MAX_DATA_PERCENT="80"
PVE_MAX_METADATA_PERCENT="70"
