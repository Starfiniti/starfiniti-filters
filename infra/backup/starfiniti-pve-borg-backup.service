[Unit]
Description=Encrypted Starfiniti Proxmox backup to Borg
Wants=network-online.target
After=network-online.target pve-cluster.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/starfiniti-pve-borg-backup
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
UMask=0077
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=full
Environment=BORG_CACHE_DIR=/var/cache/starfiniti-borg
Environment=BORG_SECURITY_DIR=/var/lib/starfiniti-borg/security
CacheDirectory=starfiniti-borg
StateDirectory=starfiniti-borg
ReadWritePaths=/run/lock /var/lib/vz
TimeoutStartSec=24h
