# Copy to /etc/starfiniti-observability/firewall.env on each guest.
# This file is shell-sourced and must be owned by root with mode 0600.

# VM 960 example: STARFINITI_LOCAL_IP=10.10.10.60,
# STARFINITI_ALLOWED_SOURCE=10.10.10.61, STARFINITI_PUBLISHED_PORT=9100.
# LXC 105 reverses the addresses and uses port 3100.
STARFINITI_PRIVATE_INTERFACE="eth0"
STARFINITI_LOCAL_IP="10.10.10.61"
STARFINITI_ALLOWED_SOURCE="10.10.10.60"
STARFINITI_PUBLISHED_PORT="3100"
