{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.starfiniti.example/operation-plan.schema.json",
  "title": "Search Operation Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "operation_id",
    "plan_hash",
    "type",
    "dry_run",
    "current_state",
    "desired_state",
    "steps",
    "risks",
    "preconditions",
    "verification",
    "rollback",
    "approval_required",
    "expires_at"
  ],
  "properties": {
    "contract_version": {
      "type": "string",
      "const": "1.0"
    },
    "operation_id": {
      "type": "string",
      "format": "uuid"
    },
    "plan_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "type": {
      "type": "string",
      "maxLength": 128
    },
    "dry_run": {
      "type": "boolean"
    },
    "current_state": {
      "type": "object"
    },
    "desired_state": {
      "type": "object"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "action",
          "description",
          "destructive",
          "idempotency_key"
        ],
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 128
          },
          "action": {
            "type": "string",
            "maxLength": 128
          },
          "description": {
            "type": "string",
            "maxLength": 4096
          },
          "destructive": {
            "type": "boolean"
          },
          "idempotency_key": {
            "type": "string",
            "maxLength": 255
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 128
            }
          }
        }
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 4096
      }
    },
    "preconditions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "estimated_impact": {
      "type": "object"
    },
    "verification": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "rollback": {
      "type": "object"
    },
    "required_scope": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    },
    "approval_required": {
      "type": "boolean"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
