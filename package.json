{
  "name": "starfiniti-filters",
  "version": "0.0.0-gate0",
  "private": true,
  "type": "module",
  "description": "Starfiniti Search for WooCommerce audit and qualification tooling",
  "scripts": {
    "audit:upstreams": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/run-node.ps1 tools/audit-upstreams.mjs",
    "baseline:filters": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/run-node.ps1 tools/start-baseline.mjs filters",
    "baseline:search": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/run-node.ps1 tools/start-baseline.mjs search",
    "runtime:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/local-runtime.ps1 setup",
    "runtime:start": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/local-runtime.ps1 start",
    "runtime:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/local-runtime.ps1 stop",
    "wordpress:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/wordpress-runtime.ps1 setup",
    "wordpress:start": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/wordpress-runtime.ps1 start",
    "wordpress:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/wordpress-runtime.ps1 stop",
    "baseline:real-db:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/fibofilters-baseline.ps1 setup",
    "baseline:real-db:start": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/fibofilters-baseline.ps1 start",
    "baseline:real-db:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/fibofilters-baseline.ps1 stop",
    "test:php": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/test-php.ps1",
    "test:mcp": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/test-mcp.ps1",
    "test:mcp:live": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/test-mcp-live.ps1",
    "test:integration": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/test-integration.ps1",
    "test:lifecycle": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/test-lifecycle.ps1",
    "test:process-kill": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/test-process-kill.ps1",
    "test:builder-kill": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/test-builder-kill.ps1",
    "test:disaster-recovery": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/test-disaster-recovery.ps1",
    "benchmark:local": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/benchmark-local.ps1",
    "benchmark:http": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/benchmark-http.ps1",
    "benchmark:http:strict": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/benchmark-http.ps1 -EnforceEndToEnd",
    "verify:release": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/run-node.ps1 tools/verify-release.mjs",
    "verify:requirements": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/run-node.ps1 tools/verify-requirements.mjs",
    "verify:architecture": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/run-node.ps1 tools/verify-architecture.mjs",
    "verify:infra": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/run-node.ps1 tools/verify-infrastructure.mjs",
    "verify:storefront": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/run-node.ps1 tools/verify-storefront.mjs",
    "verify:contracts": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/run-node.ps1 tools/validate-contracts.mjs",
    "package": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/package-plugin.ps1",
    "qualify:artifact": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/qualify-artifact.ps1",
    "test": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/run-node.ps1 tools/audit-upstreams.mjs --check && pnpm verify:requirements && pnpm verify:architecture && pnpm verify:infra && pnpm test:php && pnpm test:mcp",
    "test:all": "pnpm test && pnpm verify:storefront && pnpm verify:contracts && pnpm test:integration && pnpm test:lifecycle && pnpm test:process-kill && pnpm test:builder-kill && pnpm test:disaster-recovery && pnpm verify:release"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "GPL-3.0-only",
  "devDependencies": {
    "@wp-playground/cli": "3.1.48",
    "ajv": "8.18.0"
  }
}
