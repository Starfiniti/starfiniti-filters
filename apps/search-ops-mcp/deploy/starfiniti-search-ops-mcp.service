[Unit]
Description=Starfiniti Search Operations MCP
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=starfiniti-mcp
Group=starfiniti-mcp
WorkingDirectory=/opt/starfiniti-filters/apps/search-ops-mcp
EnvironmentFile=/etc/starfiniti/search-ops-mcp/http.env
ExecStart=/usr/bin/node /opt/starfiniti-filters/apps/search-ops-mcp/dist/src/http.js
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
ReadOnlyPaths=/etc/starfiniti/search-ops-mcp
ReadWritePaths=/var/lib/starfiniti/search-ops-mcp
UMask=0077

[Install]
WantedBy=multi-user.target
