# Public resource and Auth0 issuer. Production requires HTTPS.
STARFINITI_MCP_PUBLIC_URL=https://mcp-search.starfiniti.com/mcp
STARFINITI_MCP_AUTH_ISSUER=https://auth.starfiniti.com/
STARFINITI_MCP_TENANT_CLAIM=https://starfiniti.com/tenant_id

# Private listener. Replace with the certification VM's private address.
STARFINITI_MCP_BIND_ADDRESS=10.10.10.60
STARFINITI_MCP_PORT=3100
STARFINITI_MCP_ALLOWED_HOSTS=mcp-search.starfiniti.com
STARFINITI_MCP_ALLOWED_ORIGINS=mcp-search.starfiniti.com
STARFINITI_MCP_ADMIN_HOSTS=10.10.10.60,starfiniti-search-cert
STARFINITI_MCP_TRUSTED_PROXY_ADDRESSES=10.10.10.30

# Root-owned configuration and writable service data.
STARFINITI_MCP_SITES_FILE=/etc/starfiniti/search-ops-mcp/sites.json
STARFINITI_MCP_AUDIT_FILE=/var/lib/starfiniti/search-ops-mcp/audit.jsonl
STARFINITI_MCP_REVOCATION_FILE=/var/lib/starfiniti/search-ops-mcp/revocations.json

# Bounded request controls.
STARFINITI_MCP_MAX_BODY_BYTES=262144
STARFINITI_MCP_MAX_CONCURRENCY=32
STARFINITI_MCP_REQUESTS_PER_MINUTE=60

# Each site registration refers to a separate server-side credential variable.
STARFINITI_WP_CONTROL_STAGING=REPLACE_WITH_USERNAME_COLON_APPLICATION_PASSWORD
